{
  "expo": {
    "name": "MY PRIME",
    "slug": "my-prime",
    "version": "1.6.1",
    "orientation": "portrait",
    "scheme": "myprime",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0A0A0A",
    "android": {
      "package": "com.myprime.app",
      "versionCode": 11,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "imageWidth": 220
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00FF88"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O MY PRIME usa fotos apenas para confirmação opcional e progresso."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Prime",
              "label": "MY PRIME",
              "description": "Score de hoje, top 3 tarefas e streak.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 10800000,
              "previewImage": "./assets/widget-preview/prime.png"
            },
            {
              "name": "Constancia",
              "label": "MY PRIME · Mural",
              "description": "Mural de constância: os dias cumpridos em sequência",
              "minWidth": "250dp",
              "minHeight": "150dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 10800000,
              "previewImage": "./assets/widget-preview/constancia.png"
            }
          ]
        }
      ],
      "expo-system-ui"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    }
  }
}
