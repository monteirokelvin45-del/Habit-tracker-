    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:logic": "node scripts/run-logic-tests.mjs",
    "test:render": "node scripts/render-charts-smoke.mjs",
    "test:store": "node scripts/audited-store.mjs",
