  "devDependencies": {
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  },
  "dependencyNotes": {
    "charts": "Gráficos são desenhados com react-native-svg (components/charts.tsx) — sem react-native-chart-kit.",
